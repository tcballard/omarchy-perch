#!/usr/bin/env python3
"""Install or remove Perch's opt-in Claude permission/question bridge."""
import tomllib
import argparse,copy,importlib.machinery,importlib.util,json,os,shlex,time
from pathlib import Path
loader=importlib.machinery.SourceFileLoader('agentsetup',str(Path(__file__).with_name('perch-agent-setup')))
spec=importlib.util.spec_from_loader(loader.name,loader);setup=importlib.util.module_from_spec(spec);loader.exec_module(setup)
def transform(old,adapter,remove,agent="claude"):
    data=json.loads(old) if old.strip() else {}
    if not isinstance(data,dict):raise ValueError('Settings must be an object')
    if (data.get('disableAllHooks') or data.get('allowManagedHooksOnly')) and not remove:raise ValueError('Hooks are disabled; no changes made')
    result=copy.deepcopy(data);hooks=result.setdefault('hooks',{})
    if not isinstance(hooks,dict):raise ValueError('Invalid hooks configuration')
    command=shlex.join(['python3',str(adapter)]+(['--agent',agent] if agent!='claude' else []))
    for event,matcher in ([('PermissionRequest','*'),('PreToolUse','AskUserQuestion')] if agent=='claude' else [('PermissionRequest','*')]):
        groups=hooks.get(event,[])
        if not isinstance(groups,list):raise ValueError('Invalid hook groups')
        next_groups=[]
        for group in groups:
            if not isinstance(group,dict) or not isinstance(group.get('hooks'),list):raise ValueError('Invalid hook group')
            kept=[h for h in group['hooks'] if not (isinstance(h,dict) and h.get('type')=='command' and h.get('command')==command)]
            if kept or not group['hooks']:next_groups.append(dict(group,hooks=kept))
        if not remove:next_groups.append({'matcher':matcher,'hooks':[{'type':'command','command':command,'timeout':130}]})
        if next_groups:hooks[event]=next_groups
        else:hooks.pop(event,None)
    if not hooks:result.pop('hooks',None)
    return old if result==data else json.dumps(result,indent=2)+'\n'
def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--agent',choices=['claude','codex'],default='claude');parser.add_argument('--apply',action='store_true');parser.add_argument('--remove',action='store_true');args=parser.parse_args()
    path=Path(os.environ.get('CLAUDE_CONFIG_DIR',str(Path.home()/'.claude')))/'settings.json';adapter=Path.home()/'.local/share/omarchy-perch/perch-request-hook'
    if args.agent=='codex':
        directory=Path(os.environ.get('CODEX_HOME',str(Path.home()/'.codex')))
        config=tomllib.loads(setup.read(directory/'config.toml'))
        features=config.get('features',{})
        if not args.remove and (features.get('hooks',features.get('codex_hooks',True)) is False or config.get('allow_managed_hooks_only') or config.get('hooks',{}).get('allow_managed_hooks_only')):
            raise ValueError('Codex hooks are disabled or managed-only; no changes made')
        path=directory/'hooks.json'
    old=setup.read(path);new=transform(old,adapter,args.remove,args.agent)
    if not args.apply:print('Preview only: opt-in permission and question requests, 120-second timeout, no automatic approvals. Add --apply.');return
    if not args.remove:
        if adapter.exists() and 'Perch request bridge v1' not in setup.read(adapter):raise ValueError('Adapter path occupied')
        setup.atomic(adapter,Path(__file__).with_name('perch-request-hook').read_text(),0o700)
    if new!=old:
        if setup.read(path)!=old:raise ValueError('Settings changed during setup')
        if path.exists():setup.atomic(path.with_name(path.name+'.perch-backup-'+str(time.time_ns())),old)
        setup.atomic(path,new)
    print('Request bridge updated. Restart the agent. Review new or changed Codex hooks in /hooks; Perch never grants trust or overrides managed policy.')
if __name__=='__main__':
    try:main()
    except (OSError,ValueError) as e:raise SystemExit(str(e))
