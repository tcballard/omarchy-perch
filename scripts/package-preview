#!/usr/bin/env bash
# Build an explicitly requested, self-contained Linux preview archive.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
"$root/scripts/build-backend"
version=$(sed -n 's/.*"version": "\([^"]*\)".*/\1/p' "$root/manifest.json" | head -1)
arch=$(uname -m)
revision=$(git -C "$root" rev-parse --short=12 HEAD)
name="perch-${version}-rust-${revision}-linux-${arch}"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir -p "$stage/$name" "$root/dist"
while IFS= read -r -d '' file; do
    case "$file" in .git*|.omarchy-workbench.json|tests/*|backend/target/*) continue;; esac
    [[ -f "$root/$file" ]] || continue
    mkdir -p "$stage/$name/$(dirname "$file")"
    cp -p "$root/$file" "$stage/$name/$file"
done < <(git -C "$root" ls-files --cached --others --exclude-standard -z)
mkdir -p "$stage/$name/bin"
cp -p "$root/bin/perch-backend" "$stage/$name/bin/perch-backend"
# Package source and the compiled binary together; installs never fetch code at runtime.
epoch=${SOURCE_DATE_EPOCH:-$(git -C "$root" show -s --format=%ct HEAD)}
tar --sort=name --mtime="@$epoch" --owner=0 --group=0 --numeric-owner -C "$stage" -czf "$root/dist/$name.tar.gz" "$name"
(cd "$root/dist" && sha256sum "$name.tar.gz" > "$name.tar.gz.sha256")
printf 'Packaged %s\n' "$root/dist/$name.tar.gz"
