#!/usr/bin/env python3
"""Perch usage statusline v1: retain counters only, in a private local cache."""
import json, math, os, sys, tempfile, time
from pathlib import Path

def main():
    raw=sys.stdin.buffer.read(65537)
    if len(raw)>65536:return
    data=json.loads(raw);rates=data.get('rate_limits',{});clean={}
    if not isinstance(rates,dict):return
    for key in ('five_hour','seven_day'):
        row=rates.get(key,{})
        if not isinstance(row,dict):continue
        used=row.get('used_percentage');reset=row.get('resets_at')
        if isinstance(used,bool) or not isinstance(used,(int,float)) or not math.isfinite(used) or not 0<=used<=100:continue
        if isinstance(reset,bool) or not isinstance(reset,(int,float)) or not math.isfinite(reset) or reset<0:reset=None
        clean[key]={'used_percentage':used,'resets_at':reset}
    root=Path(os.environ.get('XDG_STATE_HOME',str(Path.home()/'.local/state')))/'omarchy-perch'
    root.mkdir(mode=0o700,parents=True,exist_ok=True)
    if root.is_symlink() or root.stat().st_uid!=os.getuid():return
    os.chmod(root,0o700)
    fd,tmp=tempfile.mkstemp(prefix='.usage-',dir=root)
    try:
        with os.fdopen(fd,'w') as out:json.dump({'rate_limits':clean,'updatedAt':time.time()},out)
        os.replace(tmp,root/'usage-claude.json')
    finally:
        if os.path.exists(tmp):os.unlink(tmp)
    print(' | '.join(('5h' if key=='five_hour' else '7d')+': '+str(round(value['used_percentage']))+'% used' for key,value in clean.items()) or 'Perch · usage unavailable')
if __name__=='__main__':
    try:main()
    except (OSError,ValueError,TypeError,AttributeError,RecursionError):pass
