#!/usr/bin/env python3
"""Opt-in, reversible Claude status-line bridge. Existing custom status lines are preserved."""
import argparse, importlib.machinery, importlib.util, json, os, shlex, time
from pathlib import Path
loader=importlib.machinery.SourceFileLoader('agentsetup',str(Path(__file__).with_name('perch-agent-setup')))
spec=importlib.util.spec_from_loader(loader.name,loader);setup=importlib.util.module_from_spec(spec);loader.exec_module(setup)
def transform(old,adapter,remove):
    data=json.loads(old) if old.strip() else {}
    if not isinstance(data,dict):raise ValueError('Settings must be an object')
    owned={'type':'command','command':shlex.join(['python3',str(adapter)])}
    existing=data.get('statusLine')
    if existing is not None and existing!=owned:
        if remove:return old
        raise ValueError('A custom status line already exists. It has been preserved; integrate the Perch usage script manually.')
    if remove:data.pop('statusLine',None)
    else:data['statusLine']=owned
    return json.dumps(data,indent=2)+'\n'
def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--apply',action='store_true');parser.add_argument('--remove',action='store_true');args=parser.parse_args()
    path=Path(os.environ.get('CLAUDE_CONFIG_DIR',str(Path.home()/'.claude')))/'settings.json'
    adapter=Path.home()/'.local/share/omarchy-perch/perch-usage-statusline'
    old=setup.read(path);new=transform(old,adapter,args.remove)
    if not args.apply:print('Preview only. Add --apply to update the Perch usage status line.');return
    if not args.remove:
        if adapter.exists() and 'Perch usage statusline v1' not in setup.read(adapter):raise ValueError('Adapter path is occupied')
        setup.atomic(adapter,Path(__file__).with_name('perch-usage-statusline').read_text(),0o700)
    if new!=old:
        if setup.read(path)!=old:raise ValueError('Settings changed during setup')
        if path.exists():setup.atomic(path.with_name(path.name+'.perch-backup-'+str(time.time_ns())),old)
        setup.atomic(path,new)
    print('Usage status line updated. Restart Claude Code.')
if __name__=='__main__':
    try:main()
    except (OSError,ValueError) as e:raise SystemExit(str(e))
