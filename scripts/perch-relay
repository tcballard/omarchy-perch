#!/usr/bin/env python3
"""Opt-in Unix-socket status receiver. SSH provides transport; no TCP listener or remote commands."""
import fcntl
from contextlib import contextmanager
import argparse,hashlib,json,os,re,signal,socket,stat,struct,sys,tempfile
from pathlib import Path
LIMIT=8192

def endpoint():
    base=Path(os.environ.get('XDG_RUNTIME_DIR',tempfile.gettempdir()))
    root=base/('perch-relay-'+str(os.getuid()))
    try:root.mkdir(mode=0o700)
    except FileExistsError:pass
    info=root.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid!=os.getuid() or stat.S_IMODE(info.st_mode)!=0o700:raise ValueError('Unsafe relay directory')
    return root/'status.sock'

@contextmanager
def locked_endpoint():
    path=endpoint()
    fd=os.open(path.with_suffix('.lock'),os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
    with os.fdopen(fd,'w') as lock:
        info=os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid!=os.getuid() or stat.S_IMODE(info.st_mode)!=0o600:raise ValueError('Unsafe relay lock')
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        if path.exists() or path.is_symlink():
            info=path.lstat()
            if not stat.S_ISSOCK(info.st_mode) or info.st_uid!=os.getuid() or stat.S_IMODE(info.st_mode)!=0o600:raise ValueError('Unsafe existing endpoint')
            with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as probe:
                probe.settimeout(.25)
                try:probe.connect(str(path))
                except ConnectionRefusedError:path.unlink()
                else:raise ValueError('Receiver already active')
        yield path

def normalize(data):
    if not isinstance(data,dict):raise ValueError('Invalid relay message')
    source=data.get('source');p=data.get('event')
    if not isinstance(source,str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,39}',source) or not isinstance(p,dict):raise ValueError('Invalid remote source')
    identity=p.get('id');state=p.get('state')
    if not isinstance(identity,str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,63}',identity) or state not in ('running','waiting','done','error'):raise ValueError('Invalid activity')
    def text(key,limit):
        value=p.get(key,'')
        return re.sub(r'[\x00-\x1f\x7f]',' ',value)[:limit] if isinstance(value,str) else ''
    # Construct a new status-only object. Never accept request identities, paths or local jump targets.
    return {'id':'remote.'+hashlib.sha256((source+':'+identity).encode()).hexdigest()[:32],
        'kind':'agent','agent':text('agent',24)+' · remote','title':source+' · '+(text('title',72) or 'Agent'),
        'project':text('project',100),'detail':{'running':'Working remotely','waiting':'Continue in your remote session','done':'Remote turn complete','error':'Remote agent reported an error'}[state],
        'state':state,'ttl':30 if state=='done' else 3600,'eventKey':text('eventKey',80)}

def receive(conn):
    value=bytearray()
    while b'\n' not in value:
        part=conn.recv(2048)
        if not part:raise ValueError('Incomplete event')
        value.extend(part)
        if len(value)>LIMIT:raise ValueError('Event too large')
    return json.loads(bytes(value).split(b'\n',1)[0])

def serve(emit,max_events=None):
    count=0
    with locked_endpoint() as path, socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as server:
        # The lock serializes restart; only an owned, unconnectable socket is removed.
        server.bind(str(path));os.chmod(path,0o600);server.listen(8)
        try:
            emit({'ready':str(path)})
            while max_events is None or count<max_events:
                conn,_=server.accept()
                with conn:
                    conn.settimeout(1)
                    try:
                        _,uid,_=struct.unpack('3i',conn.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))
                        if uid!=os.getuid():raise ValueError('Wrong relay owner')
                        event=normalize(receive(conn));emit({'event':event})
                        conn.sendall(b'{"ok":true}\n');count+=1
                    except (OSError,ValueError,TypeError,AttributeError,RecursionError):
                        try:conn.sendall(b'{"ok":false}\n')
                        except OSError:pass
        finally:path.unlink(missing_ok=True)

def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('operation',choices=['serve','path']);args=parser.parse_args()
    if args.operation=='path':print(endpoint());return
    signal.signal(signal.SIGTERM,lambda *_:sys.exit(0))
    serve(lambda message:print(json.dumps(message,separators=(',',':')),flush=True))
if __name__=='__main__':
    try:main()
    except (OSError,ValueError) as e:
        print(json.dumps({'error':'Relay could not start. Check the runtime directory and stop any existing receiver.'}),flush=True)
        raise SystemExit(1)
