#!/usr/bin/env python3
"""Best-effort, status-only Claude Code / Codex hook. Always succeeds silently."""
import hashlib
import json
import subprocess
import sys

LIMIT = 65536

def report(agent, data):
    if not isinstance(data, dict):
        return None
    if agent == 'codex':
        if data.get('type') != 'agent-turn-complete':
            return None
        session = data.get('thread-id')
        state, detail = 'done', 'Turn complete'
    elif agent == 'claude':
        session = data.get('session_id')
        event = data.get('hook_event_name')
        states = {'UserPromptSubmit': ('running', 'Working'),
                  'PostToolUse': ('running', 'Working'),
                  'Stop': ('done', 'Turn complete'),
                  'SessionEnd': ('done', 'Session ended')}
        if event == 'Notification':
            if data.get('notification_type') not in ('permission_prompt', 'idle_prompt', 'elicitation_dialog'):
                return None
            state, detail = 'waiting', 'Needs your attention in Claude Code'
        elif event in states:
            state, detail = states[event]
        else:
            return None
    else:
        return None
    if not isinstance(session, str) or not session or len(session) > 4096:
        return None
    key = hashlib.sha256(session.encode()).hexdigest()[:20]
    return {'id': agent + '.' + key, 'title': 'Codex' if agent == 'codex' else 'Claude Code',
            'state': state, 'detail': detail, 'ttl': 30 if state == 'done' else 3600}

def main():
    # A stable marker makes setup/removal ownership exact, not substring based.
    if len(sys.argv) < 3 or sys.argv[1] != '--perch-hook-v1':
        return
    agent = sys.argv[2]
    if agent == 'codex':
        if len(sys.argv) != 4:
            return
        raw = sys.argv[3]
    elif agent == 'claude' and len(sys.argv) == 3:
        raw = sys.stdin.buffer.read(LIMIT + 1)
    else:
        return
    if len(raw) > LIMIT:
        return
    payload = report(agent, json.loads(raw))
    if payload:
        subprocess.run(['omarchy-shell', 'io.github.tcballard.perch', 'activity', json.dumps(payload)],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=1, check=False)

if __name__ == '__main__':
    try:
        main()
    except (ValueError, TypeError, OSError, RecursionError, subprocess.SubprocessError):
        pass
