#!/usr/bin/env python3
"""Best-effort, status-only Claude Code / Codex hook. Always succeeds silently."""
# Also supports the documented Gemini CLI and Cursor status event formats.
import hashlib
import json
import os
import re
import socket
import stat
from pathlib import Path
import subprocess
import sys

LIMIT = 65536

def parent_pids(pid):
    result = []
    for _ in range(32):
        try:
            stat = Path(f'/proc/{pid}/stat').read_text()
            tail = stat[stat.rfind(')') + 2:].split()
            pid = int(tail[1])
        except (OSError, ValueError, IndexError):
            break
        if pid <= 1:
            break
        result.append(pid)
    return result

def process_start(pid):
    raw = Path(f'/proc/{pid}/stat').read_text()
    return raw[raw.rfind(')') + 2:].split()[19]


def tmux_target(clients):
    value, pane = os.environ.get('TMUX', ''), os.environ.get('TMUX_PANE', '')
    if not value or not re.fullmatch(r'%[0-9]+', pane):
        return {}
    path = value.rsplit(',', 2)[0]
    info = os.lstat(path)
    if not os.path.isabs(path) or not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
        return {}
    def query(*args):
        result = subprocess.run(['tmux', '-S', path, *args], stdin=subprocess.DEVNULL,
            capture_output=True, timeout=.75, check=False)
        if result.returncode or len(result.stdout) > 65536:
            raise ValueError('tmux query failed')
        return result.stdout.decode().strip()
    pane_pid, session = query('display-message', '-p', '-t', pane, '#{pane_pid} #{session_id}').split()
    pane_pid = int(pane_pid)
    if pane_pid not in parent_pids(os.getpid()):
        return {}
    candidates = []
    for line in query('list-clients', '-F', '#{client_pid} #{client_tty} #{session_id}').splitlines():
        pid, tty, attached = line.split()
        if attached != session:
            continue
        pid = int(pid)
        ancestors = set([pid] + parent_pids(pid))
        for window in clients:
            if isinstance(window, dict) and window.get('pid') in ancestors:
                candidates.append((window, {'socket':path, 'pane':pane, 'panePid':pane_pid,
                    'paneStart':process_start(pane_pid), 'client':tty, 'clientPid':pid,
                    'clientStart':process_start(pid)}))
    # Multiple attached terminals are ambiguous: never select one arbitrarily.
    if len(candidates) != 1:
        return {}
    window, target = candidates[0]
    return window_target(window, target)


def window_target(window, tmux=None):
    address = window.get('address', '')
    if not isinstance(address, str) or not re.fullmatch(r'0x[0-9a-fA-F]{1,16}', address):
        return {}
    result = {'target':address, 'targetPid':window['pid'],
        'targetBoot':Path('/proc/sys/kernel/random/boot_id').read_text().strip()}
    if tmux:
        result['targetTmux'] = tmux
    return result


def hyprland_target():
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        return {}
    try:
        completed = subprocess.run(['hyprctl', '-j', 'clients'], stdin=subprocess.DEVNULL,
            capture_output=True, timeout=.75, check=False)
        if completed.returncode or len(completed.stdout) > 262144:
            return {}
        clients = json.loads(completed.stdout)
        if os.environ.get('TMUX'):
            return tmux_target(clients)
        ancestors = set(parent_pids(os.getpid()))
        matches = [c for c in clients if isinstance(c, dict) and c.get('pid') in ancestors]
        return window_target(matches[0]) if len(matches) == 1 else {}
    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
        return {}

def project_name(data):
    cwd = data.get('cwd') if isinstance(data, dict) else None
    if not isinstance(cwd, str) or not cwd or len(cwd) > 4096:
        return ''
    name = Path(cwd).name
    return name[:100] if name not in ('', '.', '/') else cwd[:100]

def report(agent, data):
    if not isinstance(data, dict):
        return None
    attention = 'attention'
    if agent == 'codex':
        if data.get('type') != 'agent-turn-complete':
            return None
        session = data.get('thread-id')
        state, detail = 'done', 'Turn complete'
    elif agent == 'claude':
        session = data.get('session_id')
        event = data.get('hook_event_name')
        states = {'UserPromptSubmit': ('running', 'Working'),
                  'PostToolUse': ('running', 'Working'),
                  'Stop': ('done', 'Turn complete'),
                  'SessionEnd': ('done', 'Session ended')}
        if event == 'Notification':
            if data.get('notification_type') not in ('permission_prompt', 'idle_prompt', 'elicitation_dialog'):
                return None
            attention = 'approval' if data.get('notification_type') == 'permission_prompt' else 'question'
            state, detail = 'waiting', 'Needs your attention in Claude Code'
        elif event in states:
            state, detail = states[event]
        else:
            return None
    elif agent == 'gemini':
        session = data.get('session_id')
        event = data.get('hook_event_name')
        states = {'BeforeAgent': ('running','Working'), 'AfterTool': ('running','Working'),
                  'AfterAgent': ('done','Turn complete'), 'SessionEnd': ('done','Session ended')}
        if event == 'Notification' and data.get('notification_type') == 'ToolPermission':
            state,detail,attention = 'waiting','Needs your attention in Gemini CLI','approval'
        elif event in states:
            state,detail = states[event]
        else:return None
    elif agent == 'cursor':
        session = data.get('conversation_id') or data.get('session_id')
        event = data.get('hook_event_name')
        if event in ('beforeSubmitPrompt','postToolUse'):
            state,detail = 'running','Working'
        elif event in ('stop','sessionEnd'):
            status = data.get('status') or data.get('reason')
            state = 'error' if status == 'error' else 'done'
            detail = 'Agent stopped with an error' if state == 'error' else 'Turn cancelled' if status == 'aborted' else 'Session ended' if event == 'sessionEnd' else 'Turn complete'
        else:return None
        roots=data.get('workspace_roots')
        if isinstance(roots,list) and roots and isinstance(roots[0],str):data=dict(data,cwd=roots[0])
    else:
        return None
    if not isinstance(session, str) or not session or len(session) > 4096:
        return None
    key = hashlib.sha256(session.encode()).hexdigest()[:20]
    label = {'claude':'Claude','codex':'Codex','gemini':'Gemini','cursor':'Cursor'}[agent]
    return {'id': agent + '.' + key, 'title': project_name(data) or label,
            'state': state, 'detail': detail, 'ttl': 30 if state == 'done' else 3600,
            'kind': 'agent', 'agent': label,
            'project': project_name(data), **hyprland_target(), 'attention': attention,
            'eventKey': hashlib.sha256(json.dumps(data, sort_keys=True, separators=(',', ':')).encode()).hexdigest()[:32]}


def send_relay(path,payload):
    if not os.path.isabs(path) or len(path)>100:raise ValueError('Invalid relay socket')
    info=os.lstat(path)
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid!=os.getuid() or stat.S_IMODE(info.st_mode)&0o077:raise ValueError('Unsafe relay socket')
    source=os.environ.get('PERCH_REMOTE_NAME','remote')
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,39}',source):raise ValueError('Invalid remote name')
    allowed={k:payload[k] for k in ('id','state','title','project','agent','eventKey') if k in payload}
    encoded=json.dumps({'source':source,'event':allowed}).encode()+b'\n'
    if len(encoded)>8192:raise ValueError('Relay message too large')
    with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as conn:
        conn.settimeout(.75);conn.connect(path);conn.sendall(encoded);conn.recv(128)

def main():
    # A stable marker makes setup/removal ownership exact, not substring based.
    if len(sys.argv) < 3 or sys.argv[1] != '--perch-hook-v1':
        return
    agent = sys.argv[2]
    if agent == 'codex':
        if len(sys.argv) != 4:
            return
        raw = sys.argv[3]
    elif agent in ('claude','gemini','cursor') and len(sys.argv) == 3:
        raw = sys.stdin.buffer.read(LIMIT + 1)
    else:
        return
    if len(raw) > LIMIT:
        return
    payload = report(agent, json.loads(raw))
    if payload and os.environ.get('PERCH_RELAY_SOCKET'):
        send_relay(os.environ['PERCH_RELAY_SOCKET'],payload)
    elif payload:
        subprocess.run(['omarchy-shell', 'io.github.tcballard.perch', 'activity', json.dumps(payload)],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=1, check=False)

if __name__ == '__main__':
    try:
        main()
    except (ValueError, TypeError, OSError, RecursionError, subprocess.SubprocessError):
        pass

    finally:
        # Status-only observers never return permission decisions, follow-ups or prompt content.
        if len(sys.argv) >= 3 and sys.argv[2] in ('gemini','cursor'):
            print('{"continue":true}' if sys.argv[2] == 'cursor' else '{}')
