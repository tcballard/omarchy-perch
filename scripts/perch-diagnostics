#!/usr/bin/env python3
"""Measure a supplied shell PID and optional Perch IPC cycles. No log/user-text collection."""
import argparse,json,os,statistics,subprocess,time
from pathlib import Path
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--pid',type=int,required=True,help='PID of the Quickshell process hosting Omarchy')
p.add_argument('--seconds',type=int,default=10)
p.add_argument('--exercise',action='store_true',help='Explicitly open/close Perch ten times')
a=p.parse_args()
if a.pid<1 or not 2<=a.seconds<=60:p.error('Use a valid PID and 2–60 seconds')
def sample():
    fields=(Path('/proc')/str(a.pid)/'stat').read_text().rsplit(')',1)[1].split()
    return {'ticks':int(fields[11])+int(fields[12]),'rss':int(fields[21])*os.sysconf('SC_PAGE_SIZE'),'start':fields[19]}
def ipc(*args):
    start=time.monotonic()
    r=subprocess.run(['omarchy-shell',*args],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=3)
    if r.returncode:raise RuntimeError('Shell IPC failed')
    return (time.monotonic()-start)*1000
try:
    first=sample();start=time.monotonic();time.sleep(a.seconds);last=sample();elapsed=time.monotonic()-start
    if first['start']!=last['start']:raise RuntimeError('Process restarted during measurement')
    result={'pid':a.pid,'sample_seconds':round(elapsed,2),'whole_shell_cpu_percent':round((last['ticks']-first['ticks'])/os.sysconf('SC_CLK_TCK')/elapsed*100,2),'whole_shell_rss_mib':round(last['rss']/1048576,2),'rss_delta_mib':round((last['rss']-first['rss'])/1048576,2),'scope':'Whole shell, not Perch attribution; IPC round-trip is not visual frame latency'}
    if a.exercise:
        durations=[]
        try:
            for _ in range(10):
                durations.append(ipc('shell','summon','io.github.tcballard.perch'));time.sleep(.25)
                ipc('shell','hide','io.github.tcballard.perch');time.sleep(.25)
        finally:ipc('shell','hide','io.github.tcballard.perch')
        result['summon_ipc_median_ms']=round(statistics.median(durations),2)
        result['summon_ipc_max_ms']=round(max(durations),2)
    print(json.dumps(result,indent=2))
except (OSError,ValueError,RuntimeError,subprocess.SubprocessError) as error:p.exit(1,str(error)+'\n')
