#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-perch-build/target}"
cargo fmt --manifest-path "$root/backend/Cargo.toml" --check
cargo clippy --locked --manifest-path "$root/backend/Cargo.toml" --all-targets -- -D warnings
cargo test --locked --manifest-path "$root/backend/Cargo.toml"
"$root/scripts/build-backend"
python3 "$root/tests/test_backend.py"
python3 "$root/tests/test_backend_sockets.py"
python3 "$root/scripts/validate_manifest.py" "$root"
node "$root/tests/test_policy.cjs"
node "$root/tests/test_modules.cjs"
node "$root/tests/test_language.cjs"
node "$root/tests/test_notch.cjs"
node "$root/tests/test_extensions.mjs"
node "$root/tests/test_opencode_requests.mjs"
node "$root/tests/test_request_policy.cjs"
node "$root/tests/test_edges.cjs"
node "$root/tests/test_activity.cjs"
node "$root/tests/test_notifications.cjs"
python3 "$root/scripts/validate_manifest.py" "$root/companions/osd"
python3 "$root/scripts/validate_manifest.py" "$root/companions/notifications"
node "$root/tests/test_lifecycle.cjs"
bash -n "$root/demo/run" "$root/examples/build-with-perch.sh" "$root/scripts/package-preview"
for script in "$root"/scripts/perch-* "$root/scripts/build-backend" "$root/companions/notifications/perch-notification-store"; do sh -n "$script"; done
"$root/scripts/perch-activity" --help >/dev/null
python3 "$root/tests/test_helper.py"
if python3 -c 'import PySide6' >/dev/null 2>&1; then
  python3 "$root/tests/test_qml.py"
  python3 "$root/tests/test_notifications.py"
else
  printf 'Qt runtime tests skipped: install PySide6-Essentials to run production view/service tests with stubs.\n'
fi
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi
printf 'Portable checks passed; live Omarchy acceptance remains separate.\n'
